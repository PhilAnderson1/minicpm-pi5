#!/bin/sh
set -eu
if [ "$1" = configure ]; then
    if ! getent passwd minicpm-pi5 >/dev/null; then
        adduser --system --group --home /nonexistent --no-create-home --shell /usr/sbin/nologin minicpm-pi5
    fi
    # The service may read models but must not replace them.
    install -d -m 0755 /opt/minicpm-pi5/models
    # Only enable on first install. Preserve an administrator's disabled state
    # on upgrade. Never start/restart during installation or upgrade.
    if [ -z "${2:-}" ]; then
        deb-systemd-helper enable minicpm-pi5.service >/dev/null
    fi
    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload
    fi
    cat /usr/share/doc/minicpm-pi5/SETUP.txt
fi
