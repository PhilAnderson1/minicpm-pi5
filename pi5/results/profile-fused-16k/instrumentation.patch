+// Private serial profiler: each worker owns its counters and trace storage.
+static struct ggml_cgraph * pi_graph;
+static int pi_balance_enabled=0;
+static _Thread_local int64_t pi_wait_us=0;
+static _Thread_local int64_t pi_wait_calls=0;
+static struct __attribute__((aligned(128))) PiBalanceWorker {
+    int count;
+    int64_t rows[2048][8];
+} pi_workers[4];
+GGML_API void pi_balance_enable(int v) { pi_balance_enabled=v; }
+GGML_API void pi_balance_reset(void) { memset(pi_workers,0,sizeof(pi_workers)); }
+GGML_API int pi_balance_read(int worker,int row,int64_t *out) {
+    GGML_ASSERT(worker>=0 && worker<4);
+    if (row<0) return pi_workers[worker].count;
+    GGML_ASSERT(row<pi_workers[worker].count);
+    memcpy(out,pi_workers[worker].rows[row],8*sizeof(int64_t));return 1;
+}
