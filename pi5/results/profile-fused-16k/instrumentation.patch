+GGML_API void pi_balance_dump(const char * path) {
+    FILE * f=fopen(path,"w"); GGML_ASSERT(f && pi_graph);
+    fprintf(f,"node,group,op,name,type,ne0,ne1,bytes,src0,src1,src2,src0_type,src0_bytes,src1_type,src1_bytes\n");
+    for (int i=0;i<pi_graph->n_nodes;i++) {
+        struct ggml_tensor * n=pi_graph->nodes[i]; int group=-1;
+        for(int g=0;g<pi_workers[0].count;g++) if(i>=pi_workers[0].rows[g][0] && i<=pi_workers[0].rows[g][7]) {group=g;break;}
+        fprintf(f,"%d,%d,%s,%s,%s,%ld,%ld,%zu,%s,%s,%s,%s,%zu,%s,%zu\n",i,group,ggml_op_name(n->op),n->name,ggml_type_name(n->type),(long)n->ne[0],(long)n->ne[1],ggml_nbytes(n),n->src[0]?n->src[0]->name:"",n->src[1]?n->src[1]->name:"",n->src[2]?n->src[2]->name:"",n->src[0]?ggml_type_name(n->src[0]->type):"",n->src[0]?ggml_nbytes(n->src[0]):0,n->src[1]?ggml_type_name(n->src[1]->type):"",n->src[1]?ggml_nbytes(n->src[1]):0);
+    }
+    fclose(f);
+}
